{
  "name": "gta-pvm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,ws -c cyan,magenta \"next dev\" \"tsx watch server/index.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,ws -c cyan,magenta \"next start\" \"tsx server/index.ts\"",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "map:build": "tsx scripts/map/build.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "geotiff": "3.0.5",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
